# Copy this file to ".env.local" (for your computer) and fill it in.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# Never commit .env.local.

# From Supabase: Project Settings → API (or "Connect").
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (older projects call it the "anon" key). Safe to be public.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The "secret" key (older projects: "service_role"). SERVER ONLY: never put it
# in a NEXT_PUBLIC_ variable. Used for the custom-request and newsletter forms.
SUPABASE_SECRET_KEY=sb_secret_xxx

# The site's public address, used in email links. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: order status emails. Leave all empty to send none; everything else
# works the same. Use ONE of the two ways below (SMTP wins if both are set).
#
# a) SMTP, e.g. Gmail with an app password (works without owning a domain).
#    Gmail always sends from the logged-in address, so EMAIL_FROM must use it.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# b) Resend (https://resend.com). Needs your own domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Skye Crafts <yourshop@gmail.com>"

# Vercel only: a long random string. Vercel Cron sends it to /api/keepalive,
# which stops Supabase's free plan from pausing the database (see README).
CRON_SECRET=

# Only for `npm run test:db` and `npm run test:e2e` (see README).
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
E2E_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
