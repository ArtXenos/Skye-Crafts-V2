# Copy this file to ".env.local" (for your computer) and fill it in.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# Never commit .env.local.

# From Supabase: Project Settings → API (or "Connect").
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (older projects call it the "anon" key). Safe to be public.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The "secret" key (older projects: "service_role"). SERVER ONLY: never put it
# in a NEXT_PUBLIC_ variable. Used for the custom-request and newsletter forms.
SUPABASE_SECRET_KEY=sb_secret_xxx

# The site's public address, used in email links. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: order status emails through Resend (https://resend.com).
# Leave empty to send no emails; everything else works the same.
RESEND_API_KEY=
EMAIL_FROM="Skye Crafts <orders@your-domain.com>"

# Only for `npm run test:db` and `npm run test:e2e` (see README).
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
E2E_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
